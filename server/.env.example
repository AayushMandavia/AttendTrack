# ===================================================
# AttendTrack Server Environment Configuration
# Copy this file to .env and adjust values for your environment.
# Never commit real credentials or .env files to Git.
# ===================================================

# 1. PostgreSQL Database Configuration (Prisma ORM)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendtrack?schema=public"

# 2. Document Storage Provider Configuration
# Choose: 'local' (development fallback) or 's3' (object storage)
STORAGE_PROVIDER=local

# 3. Local Private Storage Settings (Active when STORAGE_PROVIDER=local)
# Files are stored in a private directory and never exposed via public static URLs
STORAGE_LOCAL_DIR=./storage/private_files

# 4. S3-Compatible Object Storage Settings (Active when STORAGE_PROVIDER=s3)
# Works with AWS S3, MinIO, Cloudflare R2, Wasabi, LocalStack
AWS_REGION=us-east-1
AWS_S3_BUCKET=attendtrack-private-documents
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_S3_ENDPOINT=http://localhost:9000     # Optional custom endpoint (for MinIO / LocalStack)
# AWS_S3_FORCE_PATH_STYLE=false             # Set to true for MinIO / LocalStack

# 5. Application Server Settings
PORT=4000
MAX_FILE_SIZE_BYTES=10485760 # 10MB in bytes
